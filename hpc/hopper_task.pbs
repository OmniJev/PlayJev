#!/bin/bash
#PBS -N pj_task
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB:gpu_model=H200
#PBS -l walltime=06:00:00
#PBS -q autox
#PBS -j oe
# One command from the repo on a hopper H200 node, the PlayJev venv active (the hopper twin of hpc/vanda_task.pbs).
#   cd $WORK && bash repo/hpc/q.sh -v 'NAME=trshuf,CMD=bash hpc/transfer_ft.sh racer 1000 shuf' repo/hpc/hopper_task.pbs
#   bash repo/hpc/q.sh -W depend=afterok:<jobid> -v 'NAME=...,CMD=...' repo/hpc/hopper_task.pbs   # after another job succeeds
# Variables: NAME (log name), CMD (shell command, cwd = the repo), THREADS (OMP threads, default 6).
WORK=${PLAYJEV_WORK:-${PBS_O_WORKDIR:-$PWD}}   # work tree: repo/ .venv/ logs/ site.env
if [ -f "$WORK/site.env" ]; then . "$WORK/site.env"; fi
REPO=$WORK/repo
JOB=${PBS_JOBID%%.*}
NAME=${NAME:-task}
exec > $WORK/logs/${NAME}_${JOB}_live.log 2>&1
date; hostname; nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
cd $REPO
source $WORK/.venv/bin/activate
export HF_HOME=${HF_HOME:-$WORK/hf_home}
export HF_HUB_CACHE=$HF_HOME/hub HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
export PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-$WORK/ms-playwright}
export OMP_NUM_THREADS=${THREADS:-6}
export WORK=${CKPT_WORK:-$WORK}   # hpc/transfer_*.sh read checkpoints from here (site.env: CKPT_WORK)
echo "CMD: $CMD"
eval "$CMD"
echo "exit $?"; date; echo TASK_DONE
