#!/bin/bash
#PBS -N pj_profile
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB:gpu_model=H200
#PBS -l walltime=00:20:00
#PBS -q autox
#PBS -j oe
# Follow-up to smoke.pbs: where does a batch-32 forward of Qwen3.5-0.8B-Base spend its time, and how does
# throughput scale to batch 64 and 128.   cd $WORK && bash repo/hpc/q.sh repo/hpc/profile.pbs
WORK=${PLAYJEV_WORK:-${PBS_O_WORKDIR:-$PWD}}   # work tree: repo/ .venv/ logs/ site.env
if [ -f "$WORK/site.env" ]; then . "$WORK/site.env"; fi
REPO=$WORK/repo
JOB=${PBS_JOBID%%.*}
exec > $WORK/logs/profile_${JOB}_live.log 2>&1
date; hostname
cd $REPO
source $WORK/.venv/bin/activate
export HF_HOME=${HF_HOME:-$WORK/hf_home}
export HF_HUB_CACHE=$HF_HOME/hub HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
M08B=$HF_HOME/hub/models--Qwen--Qwen3.5-0.8B-Base/snapshots/dc7cdfe2ee4154fa7e30f5b51ca41bfa40174e68
OUT=$REPO/runs/smoke/$JOB; mkdir -p $OUT
python -u -m playjev.zeroshot --model $M08B --template plain --game snake --frames runs/bench/snake --batch 32 \
    --no-control --no-shift-check --latency 32,64,128 --latency-sizes 448 --profile 32 --out $OUT/q08b_plain_profile.json
date; echo PROFILE_DONE
