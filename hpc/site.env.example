# Copy to $WORK/site.env (one level above the repo, never committed) and fill in for this cluster.
# hpc/q.sh and every hpc/*.pbs source it; each line is optional, the defaults below are what the
# scripts assume when the file is absent.

# Project / account code passed to qsub as -P (leave empty if the queue does not need one).
PBS_PROJECT=

# Where PBS drops the job .o files. The jobs also stream to $WORK/logs/*_live.log while they run.
PLAYJEV_LOGS=$WORK/logs

# Checkpoint root. Point it at the project disk when checkpoints must not live on personal scratch.
CKPT_ROOT=$WORK/ckpt

# Work tree that hpc/transfer_*.sh read checkpoints from, when it differs from $WORK
# (hopper: fast scratch for repo/venv/logs, project scratch for checkpoints).
CKPT_WORK=$WORK

# Hugging Face cache and the Playwright Chromium build.
HF_HOME=$WORK/hf_home
PLAYWRIGHT_BROWSERS_PATH=$WORK/ms-playwright

# Fallback interpreter used by hpc/smoke.pbs if the main venv cannot run Chromium.
PROBE_VENV=$WORK/probe_games_venv
