#!/bin/bash
#PBS -P PROJECT
#PBS -N pj_sft
#PBS -l select=1:ngpus=1:ncpus=12:mem=225GB:gpu_model=H200
#PBS -l walltime=12:00:00
#PBS -q autox
#PBS -j oe
#PBS -o $WORK/logs/
# Stage B (docs/DESIGN.md section 5) end to end in one job: teacher rollouts on the node's 12 CPU cores, then
# supervised fine-tuning on the H200, then the closed-loop score of the trained model against random and teacher.
#
#   cd $WORK && qsub -v GAMES="snake",FRAMES=100000,RUN=sft_snake1 repo/hpc/train_sft.pbs
#
# qsub -v variables: GAMES (space separated, default snake), FRAMES per game (default 100000), EPOCHS (1),
# RUN (name, default sft_<jobid>), MODEL (snapshot path, default Qwen3.5-0.8B-Base), MICRO (micro batch, 64),
# EXTRA (extra playjev.train_sft flags, e.g. "--freeze-vision" or "--two-frame"), SKIP_COLLECT=1 to reuse the
# shards of an earlier run with the same RUN name, PLAY_EXTRA (extra playjev.play flags, e.g. "--two-frame").
WORK=$WORK
REPO=$WORK/repo
JOB=${PBS_JOBID%%.*}
GAMES=${GAMES:-snake}; FRAMES=${FRAMES:-100000}; EPOCHS=${EPOCHS:-1}; RUN=${RUN:-sft_$JOB}; MICRO=${MICRO:-64}
CKPT_ROOT=$WORK/ckpt
exec > $WORK/logs/train_${RUN}_${JOB}_live.log 2>&1   # PBS -o only lands when the job ends
date; hostname
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
cd $REPO
source $WORK/.venv/bin/activate
export HF_HOME=$PROJ/hf_home
export HF_HUB_CACHE=$HF_HOME/hub HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
export PLAYWRIGHT_BROWSERS_PATH=$SCRATCH/ms-playwright
MODEL=${MODEL:-$HF_HOME/hub/models--Qwen--Qwen3.5-0.8B-Base/snapshots/dc7cdfe2ee4154fa7e30f5b51ca41bfa40174e68}
OUT=$CKPT_ROOT/$RUN
mkdir -p $OUT
echo "RUN=$RUN GAMES=$GAMES FRAMES=$FRAMES EPOCHS=$EPOCHS MODEL=$MODEL MICRO=$MICRO EXTRA=$EXTRA"
python -c "from playjev.teachers import _REGISTRY; print('teachers:', sorted(_REGISTRY))"

# 1. Collect: three shards per game at a time (two at epsilon 0.1, one at 0.3), seed0 a multiple of 10 so the
#    seed % 10 == 0 validation split exists; the ranges are far apart so shards never share an episode seed.
if [ -z "$SKIP_COLLECT" ]; then
    PER=$(( FRAMES / 3 ))
    for g in $GAMES; do
        t0=$(date +%s)
        python -u -m playjev.collect $g --steps $PER --pages 8 --epsilon 0.1 --shard ${RUN}_a --seed0 100000 > $WORK/logs/collect_${RUN}_${g}_a.log 2>&1 &
        P1=$!
        python -u -m playjev.collect $g --steps $PER --pages 8 --epsilon 0.1 --shard ${RUN}_b --seed0 300000 > $WORK/logs/collect_${RUN}_${g}_b.log 2>&1 &
        P2=$!
        python -u -m playjev.collect $g --steps $PER --pages 8 --epsilon 0.3 --shard ${RUN}_c --seed0 500000 > $WORK/logs/collect_${RUN}_${g}_c.log 2>&1 &
        P3=$!
        wait $P1 $P2 $P3
        echo "[collect $g] $(( $(date +%s) - t0 )) s"; for s in a b c; do tail -1 $WORK/logs/collect_${RUN}_${g}_$s.log; done
        grep -h "errors:" $WORK/logs/collect_${RUN}_${g}_*.log | head -3
    done
fi
python -u -m playjev.data $GAMES

# 2. Train.
python -u -m playjev.train_sft --games $GAMES --shards ${RUN}_a ${RUN}_b ${RUN}_c --model $MODEL --out $OUT \
    --epochs $EPOCHS --batch 64 --micro-batch $MICRO --workers 10 --eval-every 400 --save-every 400 --keep 2 $EXTRA

# 3. Closed loop on held-out seeds: trained model, random, teacher (16 episodes each, 8 pages).
for g in $GAMES; do
    echo "[play $g] trained model"
    python -u -m playjev.play $g --policy local --ckpt $OUT/final --episodes 16 --pages 8 --seed0 5000 $PLAY_EXTRA
    cp $REPO/runs/play/${g}_local.json $OUT/play_${g}_local.json
    echo "[play $g] random"
    python -u -m playjev.play $g --policy random --episodes 16 --pages 8 --seed0 5000
    echo "[play $g] teacher"
    python -u -m playjev.play $g --policy teacher --episodes 16 --pages 8 --seed0 5000
done
echo "[final eval]"; cat $OUT/final_eval.json
date
echo SFT_DONE
